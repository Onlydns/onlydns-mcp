{
  "name": "@onlydns/mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for OnlyDNS - manage DNS zones, records, DNSSEC, and TSIG keys.",
  "author": "OnlyDNS <support@onlydns.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/onlydns/onlydns-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/onlydns/onlydns-mcp/issues"
  },
  "homepage": "https://github.com/onlydns/onlydns-mcp#readme",
  "bin": {
    "onlydns-mcp": "dist/index.js",
    "@onlydns/mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onlydns",
    "dns",
    "dns-management",
    "ai-agent",
    "claude",
    "cursor"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@onlydns/sdk": "^1.0.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
